{
 "productName": "MacNotch",
 "version": "0.1.0",
 "identifier": "app.macnotch",
 "build": {
  "beforeDevCommand": "npm run dev",
  "devUrl": "http://localhost:1420",
  "beforeBuildCommand": "npm run build",
  "frontendDist": "../dist"
 },
 "app": {
  "windows": [],
  "security": {
   "csp": null
  }
 },
 "bundle": {
  "active": true,
  "targets": [
   "nsis"
  ],
  "icon": [
   "icons/icon.ico"
  ],
  "windows": {
   "webviewInstallMode": {
    "type": "offlineInstaller"
   },
   "nsis": {
    "installMode": "currentUser"
   }
  }
 }
}